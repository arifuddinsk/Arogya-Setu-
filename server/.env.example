# Arogya Setu - Backend Environment Configuration

# Server Port (default 5000)
PORT=5000

# Environment mode ('development' | 'production')
NODE_ENV=production

# Allowed CORS Origins (comma-separated or '*' for all)
CORS_ORIGIN=*

# Optional custom database file path (defaults to arogya_setu.db inside server folder)
# DB_PATH=/var/data/arogya_setu.db
