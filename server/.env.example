# Arogya Setu - Backend Environment Configuration

# Server Port (automatically set by Render in production; defaults to 5000 locally)
PORT=5000

# Environment mode ('development' | 'production')
NODE_ENV=production

# Allowed CORS Origins (comma-separated origins or '*' for all)
# Example: https://arogya-setu.vercel.app,http://localhost:5173 or *
CORS_ORIGIN=*

# Persistent SQLite Database Path
# In local development: leave unset to default to local arogya_setu.db inside server folder.
# In Render production (with Persistent Disk mounted at /data):
DB_PATH=/data/arogya_setu.db
