# Arogya Setu - Frontend Environment Configuration
# Base URL for API requests. In development, point to local Express server:
VITE_API_URL=http://localhost:5000/api

# In production deployments (e.g. Vercel, Netlify, Render), configure:
# VITE_API_URL=https://api.yourdomain.com/api
# Or when running behind a reverse proxy on the same origin:
# VITE_API_URL=/api
